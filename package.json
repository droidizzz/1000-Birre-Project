    "beer",
    "birre",
    "statistics",
    "dashboard",
    "cli"
  ],
  "license": "MIT",
  "author": "droidizzz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droidizzz/1000-Birre-Project.git"
  },
  "homepage": "https://github.com/droidizzz/1000-Birre-Project#readme",
  "bugs": {
    "url": "https://github.com/droidizzz/1000-Birre-Project/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
